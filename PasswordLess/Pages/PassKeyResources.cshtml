@page
@model PassKeyResourcesModel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@attribute [Authorize]
@{
    ViewData["Title"] = "Passkey Resources";
}

<div class="container mt-5">
    <h1 class="mb-4">Passkey Resources</h1>
    <p class="lead">Welcome to the Passkey Resources page. Only authenticated users can access this content.</p>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Credential Id</th>
                    <th scope="col">Display name</th>
                    <th scope="col">Backed Up</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserPasskeyInfo passkey in Model.PassKeys)
                {
                    <tr>
                        <td>@Convert.ToHexString(passkey.CredentialId)</td>
                        <td>@passkey.Name</td>
                        <td>
                            <span class="badge @(passkey.IsBackedUp ? "bg-success" : "bg-danger")">
                                @(passkey.IsBackedUp ? "Yes" : "No")
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="credentialId" value="@Convert.ToHexString(passkey.CredentialId)" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="mt-4 text-end">
        <a href="/Account/SetupPasskey" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Add Another Passkey
        </a>
    </div>
</div>
