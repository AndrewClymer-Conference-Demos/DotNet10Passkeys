@page
@model Account.SetupPasskey

<div class="container py-5 ">
    <div class="mx-auto" style="max-width: 400px;">

        <h1 class="mb-4">Create Passkey</h1>

        <img src="~/img/authCollage.png" alt="Passkey Logo" class="img-fluid d-block mx-auto mb-4"/>

        <p class="fw-bold">
            With passkeys, you don't need to remember passwords.
        </p>

        <ul class="text-start">
            <li>
                <b>What are passkeys?</b>
                <p>Passkeys are encrypted digital keys you create using your fingerprint, face or screen lock.</p>
            </li>
            <li>
                <b>Where are passkeys saved?</b>
                <p>Passkeys are saved to your password manager, so you can sign in on other devices.</p>
            </li>
        </ul>

        <div class="form-group">
            <label  for="deviceName">Key name (Optional)</label>
            <input  type="text" id="deviceName" name="deviceName" class="form-control px-4"/>
        </div>
        <br/>
        <button type="button"
                    id="registerButton"
                    class="btn btn-primary px-4"
                    style="min-width: 220px; min-height: 48px;">
                Create Passkey
            </button>
        
        <div class="mt-3">
            <p id="status"></p>
        </div>

    </div>
</div>


<script src="/js/passkey.js"></script>

@section Scripts {
    <script>
        const statusElement = document.getElementById('status');
        const deviceName = document.getElementById('deviceName');
        
        document.getElementById('registerButton').addEventListener('click', async function () {
           statusElement.textContent = "Registering Your Passkey.....";
            
           try {
               const registerResult= await registerPasskey(deviceName.value);

               if ( registerResult ) {
                   window.location = "/";
               }
               else
               {
                   statusElement.textContent = "Passkey registration failed. Please try again.";
               }
           }
           catch(error)
           {
               statusElement.textContent = error.message;
           }
           
            
        });
    </script>
}
