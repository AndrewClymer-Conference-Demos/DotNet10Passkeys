@page
@{
    ViewData["Title"] = "Passkey Login";
}

<div class="container py-5">
    <div class="mx-auto" style="max-width: 400px;">
        <h1>Sign-in</h1>
        <form id="loginForm">
            <div class="form-group ">
                <label  for="userName">Email (Optional)</label>
                <input  type="text" id="userName" name="userName" class="form-control px-4" autocomplete="username webauthn"/>
            </div>
            <br/>
            <button type="button" id="loginButton" class="btn btn-primary px-4">Sign-in with Passkey</button>
            <button type="button" id="registerButton" class="btn btn-secondary px-4" onclick="window.location.href='/Account/UserRegistration'">Register</button>
        </form>
        <div>
            <p id="status"></p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/passkey.js"></script>
    <script>
        
        async function login(mediation){
            const statusElement = document.getElementById('status');

            statusElement.textContent = 'Initiating Passkey login...';
            const username = document.getElementById('userName').value;

            const signInSuccess = await verifyPasskey(username,mediation);
            
            if (signInSuccess) {
                const urlParams = new URLSearchParams(window.location.search);
                const returnUrl = urlParams.get('ReturnUrl') || '/';
                console.log('Passkey login successful');
                window.location.href = returnUrl;
            } else {
                console.error('Passkey login failed');
                statusElement.textContent = 'Passkey login failed. Please try again.';
            }
            
        }
        
       document.getElementById('loginButton').addEventListener('click', async function() {await login("optional")});
      
        document.addEventListener("DOMContentLoaded", async function() { await login("conditional")}); 
        
    </script>
}
