@page
@model DIgitalFrontDoor.Pages.Account.VerifyEmail


<div class="container py-5 ">
    <div class="mx-auto" style="max-width: 400px;">

        <h1 class="mb-4">Verify Email</h1>
        
        <form id="registrationForm" class="mt-4" method="post">

            <div class="mb-3 mx-auto" style="max-width: 400px;">
                <label class="form-label fw-semibold" for="code">
                    Code
                </label>
                <input type="text"
                       id="code"
                       name="code"
                       class="form-control form-control-sm"
                       required />
            </div>
            
            <button type="submit" 
                    id="registerButton"
                    class="btn btn-primary px-4"
                    style="min-width: 220px; min-height: 48px;">
                Submit Code
            </button>

        </form>

    </div>
</div>